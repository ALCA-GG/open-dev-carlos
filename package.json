{
  "name": "opendev",
  "version": "0.1.0",
  "private": true,
  "description": "Herramientas de desarrollo del repositorio educativo OpenDev.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "validate:commit": "node scripts/check-commit-message.js",
    "validate:structure": "node scripts/validate-structure.js",
    "format:check": "prettier --check \"**/*.md\" \"*.json\"",
    "format:write": "prettier --write \"**/*.md\" \"*.json\"",
    "validate": "npm run validate:structure && npm run format:check"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "prettier": "3.10.1"
  }
}
